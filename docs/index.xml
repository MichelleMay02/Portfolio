    <item>
      <title>Curriculum Vitae</title>
      <link>https://example.org/cv/</link>
      <pubDate>Tue, 23 Sep 2025 15:00:00 -0400</pubDate>
      <guid>https://example.org/cv/</guid>
      <description>&lt;style&gt;&#xD;&#xA;/* === GENERAL STYLING === */&#xD;&#xA;body {&#xD;&#xA;  font-family: &#39;Helvetica Neue&#39;, Arial, sans-serif;&#xD;&#xA;  line-height: 1.6;&#xD;&#xA;  margin: 0;&#xD;&#xA;  padding: 0;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;/* === FADE-IN SECTIONS === */&#xD;&#xA;.fade-section {&#xD;&#xA;  opacity: 0;&#xD;&#xA;  transform: translateY(20px);&#xD;&#xA;  transition: opacity 0.8s ease-out, transform 0.8s ease-out;&#xD;&#xA;}&#xD;&#xA;.fade-section.visible {&#xD;&#xA;  opacity: 1;&#xD;&#xA;  transform: translateY(0);&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;/* === SKILL BUTTONS &amp; MODALS === */&#xD;&#xA;.skills-container {&#xD;&#xA;  display: flex;&#xD;&#xA;  flex-wrap: wrap;&#xD;&#xA;  justify-content: center;&#xD;&#xA;  gap: 0.5rem;&#xD;&#xA;  margin-top: 1rem;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;.skill-btn {&#xD;&#xA;  background: #2ecc71;&#xD;&#xA;  color: white;&#xD;&#xA;  padding: 0.75rem 1.25rem;&#xD;&#xA;  border-radius: 10px;&#xD;&#xA;  border: none;&#xD;&#xA;  cursor: pointer;&#xD;&#xA;  font-weight: 600;&#xD;&#xA;}&#xD;&#xA;.skill-btn:hover { background: #27ae60; }&#xD;&#xA;&#xD;&#xA;.modal {&#xD;&#xA;  display: none;&#xD;&#xA;  position: fixed;&#xD;&#xA;  inset: 0;&#xD;&#xA;  background: rgba(0,0,0,0.6);&#xD;&#xA;  z-index: 1000;&#xD;&#xA;  overflow-y: auto;&#xD;&#xA;}&#xD;&#xA;.modal-content {&#xD;&#xA;  background: white;&#xD;&#xA;  padding: 2rem;&#xD;&#xA;  border-radius: 12px;&#xD;&#xA;  max-width: 520px;&#xD;&#xA;  margin: 5% auto;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;/* === ZIG-ZAG TIMELINE === */&#xD;&#xA;.timeline {&#xD;&#xA;  position: relative;&#xD;&#xA;  margin: 2rem 0;&#xD;&#xA;  padding: 0;&#xD;&#xA;}&#xD;&#xA;.timeline::before {&#xD;&#xA;  content: &#34;&#34;;&#xD;&#xA;  position: absolute;&#xD;&#xA;  left: 50%;&#xD;&#xA;  top: 0;&#xD;&#xA;  bottom: 0;&#xD;&#xA;  width: 4px;&#xD;&#xA;  background: #0077b6;&#xD;&#xA;  transform: translateX(-50%);&#xD;&#xA;}&#xD;&#xA;.timeline-entry {&#xD;&#xA;  position: relative;&#xD;&#xA;  width: 50%;&#xD;&#xA;  padding: 1rem 2rem;&#xD;&#xA;  box-sizing: border-box;&#xD;&#xA;  opacity: 0;&#xD;&#xA;  transform: translateY(20px);&#xD;&#xA;  transition: opacity 0.8s ease-out, transform 0.8s ease-out;&#xD;&#xA;  cursor: pointer;&#xD;&#xA;}&#xD;&#xA;.timeline-entry.visible {&#xD;&#xA;  opacity: 1;&#xD;&#xA;  transform: translateY(0);&#xD;&#xA;}&#xD;&#xA;.timeline-entry:nth-child(odd) {&#xD;&#xA;  left: 0;&#xD;&#xA;  text-align: right;&#xD;&#xA;}&#xD;&#xA;.timeline-entry:nth-child(even) {&#xD;&#xA;  left: 50%;&#xD;&#xA;  text-align: left;&#xD;&#xA;}&#xD;&#xA;.timeline-entry::before {&#xD;&#xA;  content: &#34;&#34;;&#xD;&#xA;  position: absolute;&#xD;&#xA;  top: 1rem;&#xD;&#xA;  width: 16px;&#xD;&#xA;  height: 16px;&#xD;&#xA;  background: #0077b6;&#xD;&#xA;  border-radius: 50%;&#xD;&#xA;  z-index: 1;&#xD;&#xA;}&#xD;&#xA;.timeline-entry:nth-child(odd)::before {&#xD;&#xA;  right: -8px;&#xD;&#xA;}&#xD;&#xA;.timeline-entry:nth-child(even)::before {&#xD;&#xA;  left: -8px;&#xD;&#xA;}&#xD;&#xA;.timeline-entry h3 {&#xD;&#xA;  margin: 0.2rem 0;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;/* === SIDE PANEL === */&#xD;&#xA;.details-panel {&#xD;&#xA;  position: fixed;&#xD;&#xA;  top: 0;&#xD;&#xA;  right: -100%;&#xD;&#xA;  width: 400px;&#xD;&#xA;  height: 100%;&#xD;&#xA;  background: #f4f4f4;&#xD;&#xA;  box-shadow: -4px 0 12px rgba(0,0,0,0.2);&#xD;&#xA;  transition: right 0.5s ease;&#xD;&#xA;  padding: 2rem;&#xD;&#xA;  overflow-y: auto;&#xD;&#xA;  z-index: 1000;&#xD;&#xA;}&#xD;&#xA;.details-panel.active { right: 0; }&#xD;&#xA;.details-panel h3 { margin-top: 0; color: #0077b6; }&#xD;&#xA;.details-panel p { margin-bottom: 1rem; }&#xD;&#xA;.details-panel .close-btn {&#xD;&#xA;  position: absolute;&#xD;&#xA;  top: 1rem;&#xD;&#xA;  right: 1rem;&#xD;&#xA;  background: #0077b6;&#xD;&#xA;  color: white;&#xD;&#xA;  border: none;&#xD;&#xA;  border-radius: 50%;&#xD;&#xA;  width: 28px;&#xD;&#xA;  height: 28px;&#xD;&#xA;  font-weight: bold;&#xD;&#xA;  cursor: pointer;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;/* === LINK STYLING === */&#xD;&#xA;a { text-decoration: none; color: #0077b6; }&#xD;&#xA;a:hover { text-decoration: underline; }&#xD;&#xA;&lt;/style&gt;&#xD;&#xA;&lt;div style=&#34;text-align: center; margin-bottom: 1rem;&#34;&gt;&#xD;&#xA;  &lt;a href=&#34;https://example.org/Michelle_Wagner_CV.pdf&#34; style=&#34;font-weight: bold; color: #0077b6; font-size: 1.1rem;&#34;&gt;📄 Download my CV (PDF)&lt;/a&gt;&#xD;&#xA;&lt;/div&gt;&#xD;&#xA;&lt;hr&gt;&#xA;&lt;div class=&#34;fade-section&#34; style=&#34;display: flex; justify-content: center; flex-wrap: wrap; gap: 0.5rem; align-items: center; font-weight: bold; font-family: &#39;Helvetica Neue&#39;, Arial, sans-serif; font-size: 1rem; color: #0077b6;&#34;&gt;&#xD;&#xA;  &lt;span&gt;@mwagner000@citymail.cuny.edu&lt;/span&gt;&#xD;&#xA;  &lt;span style=&#34;margin: 0 0.5rem;&#34;&gt;♦&lt;/span&gt;&#xD;&#xA;  &lt;span&gt;&lt;a href=&#34;https://linkedin.com/in/michelle-may-wagner&#34; target=&#34;_blank&#34;&gt;linkedin.com/in/michelle-may-wagner&lt;/a&gt;&lt;/span&gt;&#xD;&#xA;  &lt;span style=&#34;margin: 0 0.5rem;&#34;&gt;♦&lt;/span&gt;&#xD;&#xA;  &lt;span&gt;&lt;a href=&#34;https://github.com/yourname&#34; target=&#34;_blank&#34;&gt;github.com/yourname&lt;/a&gt;&lt;/span&gt;&#xD;&#xA;&lt;/div&gt;&#xD;&#xA;&lt;hr&gt;&#xA;&lt;div class=&#34;fade-section&#34; id=&#34;skills&#34;&gt;&#xD;&#xA;&lt;h2 style=&#34;text-align: center; font-weight: bold; color: #0077b6; margin-bottom: 1rem;&#34;&gt;Skills&lt;/h2&gt;&#xD;&#xA;&lt;div class=&#34;skills-container&#34;&gt;&#xD;&#xA;  &lt;button class=&#34;skill-btn&#34; onclick=&#34;openModal(&#39;satelliteModal&#39;)&#34;&gt;Satellite Data Processing&lt;/button&gt;&#xD;&#xA;  &lt;button class=&#34;skill-btn&#34; onclick=&#34;openModal(&#39;geoModal&#39;)&#34;&gt;Geospatial Analysis&lt;/button&gt;&#xD;&#xA;  &lt;button class=&#34;skill-btn&#34; onclick=&#34;openModal(&#39;oceanModal&#39;)&#34;&gt;Ocean Color Calibration&lt;/button&gt;&#xD;&#xA;  &lt;button class=&#34;skill-btn&#34; onclick=&#34;openModal(&#39;reanalysisModal&#39;)&#34;&gt;Atmospheric Reanalysis&lt;/button&gt;&#xD;&#xA;  &lt;button class=&#34;skill-btn&#34; onclick=&#34;openModal(&#39;climateModal&#39;)&#34;&gt;Climate Modeling&lt;/button&gt;&#xD;&#xA;  &lt;button class=&#34;skill-btn&#34; onclick=&#34;openModal(&#39;pythonModal&#39;)&#34;&gt;Python Programming&lt;/button&gt;&#xD;&#xA;  &lt;button class=&#34;skill-btn&#34; onclick=&#34;openModal(&#39;matlabModal&#39;)&#34;&gt;MATLAB &amp; R&lt;/button&gt;&#xD;&#xA;  &lt;button class=&#34;skill-btn&#34; onclick=&#34;openModal(&#39;cppModal&#39;)&#34;&gt;C++ &amp; Arduino&lt;/button&gt;&#xD;&#xA;&lt;/div&gt;&#xD;&#xA;&lt;/div&gt;&#xD;&#xA;&lt;!-- Skill Modals (unchanged) --&gt;&#xD;&#xA;&lt;div id=&#34;satelliteModal&#34; class=&#34;modal&#34; onclick=&#34;closeModal(this)&#34;&gt;&#xD;&#xA;  &lt;div class=&#34;modal-content&#34; onclick=&#34;event.stopPropagation()&#34;&gt;&#xD;&#xA;    &lt;h3&gt;Satellite Data Processing&lt;/h3&gt;&#xD;&#xA;    &lt;p&gt;Processed and analyzed satellite datasets using SNAP and custom workflows...&lt;/p&gt;</description>
    </item>
